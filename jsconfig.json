{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "checkJs": true,
    "allowJs": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": [
    "pages/**/*.js",
    "components/**/*.js",
    "api/**/*.js",
    "fixtures/**/*.js",
    "utils/**/*.js",
    "flows/**/*.js",
    "config/**/*.js",
    "tests/**/*.js",
    "actions/**/*.js"
  ]
}
